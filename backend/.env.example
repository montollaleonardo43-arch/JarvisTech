# ============================================================
# Jarvis Technology - Backend Next.js (API /api/v1)
# Copia este archivo a `.env` y completa los valores reales.
# NUNCA subas `.env` al repositorio.
# ============================================================

# --- Base de datos PostgreSQL (Supabase) ---
# URL del pooler transaccional (port 6543). Solo lectura/escritura de datos.
DATABASE_URL="postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexion directa (port 5432) usada por Prisma como fallback / herramientas CLI.
DIRECT_URL="postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# --- JWT (replica exacta del JWT de Spring Boot) ---
# Secret base64: Keys.hmacShaKeyFor(Decoders.BASE64.decode(secret)) + HS256, sub=email, exp=1h.
JWT_SECRET="<base64-secret-igual-al-de-spring>"
# Expiración en milisegundos (Spring usa 3600000 => 1 hora).
JWT_EXPIRATION_MS=3600000

# --- Supabase (Storage de imágenes) ---
# URL del proyecto (https://<project-ref>.supabase.co).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# Service Role Key (permite crear bucket y subir archivos). Se obtiene en
# Supabase Dashboard > Project Settings > API Keys > service_role.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
# Nombre del bucket de imágenes (se crea automáticamente al primer upload).
SUPABASE_STORAGE_BUCKET="jarvisecommerce-images"

# --- MercadoPago (módulo de pago - esqueleto) ---
MERCADOPAGO_ACCESS_TOKEN="<access-token>"
MERCADOPAGO_WEBHOOK_SECRET="<webhook-secret>"